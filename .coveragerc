[run]
branch = True
source =
    tools
relative_files = True
omit =
    tools/android-arm64/test_*.py
    tools/benchmarks/test_*.py
    tools/governance/test_*.py
    tools/model-artifacts/test_*.py

[report]
precision = 2
show_missing = True
skip_empty = True

[xml]
output = build/quality/python-coverage.xml

[json]
output = build/quality/python-coverage.json
pretty_print = True
